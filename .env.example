APP_NAME="Fatafat API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fatafatnew
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

API_RATE_LIMIT=60
API_VERSION=v1

FRONTEND_URL=http://localhost:3000

ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=http://localhost:8000/api/v1/payment/esewa/callback
ESEWA_FAILURE_URL=http://localhost:8000/api/v1/payment/esewa/callback

NICASIA_ACCESS_KEY=
NICASIA_PROFILE_ID=
NICASIA_SECRET_KEY=
NICASIA_PAYMENT_URL=https://testsecureacceptance.cybersource.com/pay
NICASIA_SUCCESS_URL=http://localhost:8000/api/v1/payment/nicasia/callback
NICASIA_CANCEL_URL=http://localhost:8000/api/v1/payment/nicasia/callback

KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:8000/api/v1/payment/khalti/callback
